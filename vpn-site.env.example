# Случайная строка для подписи сессий: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замените-на-случайную-строку
# Адрес сайта (с портом, если он не 443)
BASE_URL=https://vpn.example.com:8443
# Название, которое видят посетители
SITE_NAME=Tunnel
# Почта админов (через запятую): им открыта страница /admin
ADMIN_EMAILS=you@example.com
# Сколько ключей на одну подписку
MAX_KEYS=1
# Один ключ — одно устройство: если ключ дольше SHARE_MINUTES минут подряд работает
# из двух разных сетей, в первый раз он отключается на BAN_MINUTES минут, во второй удаляется,
# и создать новый человек не может (вернуть доступ: /admin → «Вернуть доступ»).
# Нужен свежий Xray (проверено на 26.3); API и учёт адресов сайт включит в конфиге Xray сам.
DEVICE_LIMIT=1
SHARE_MINUTES=6
BAN_MINUTES=15
# Тарифы: код:дней:цена в рублях:название, через запятую
PLANS=1m:30:199:1 месяц,3m:90:499:3 месяца,12m:365:1690:12 месяцев
# test — оплата-заглушка (деньги не списываются); yookassa — настоящая оплата
PAYMENT_PROVIDER=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Предзапуск: 0 — выключить оплату или выдачу ключей (регистрация при этом работает).
# С KEYS_ENABLED=0 сайту не нужен Xray, его можно запускать на любом сервере.
PAYMENTS_ENABLED=1
KEYS_ENABLED=1
