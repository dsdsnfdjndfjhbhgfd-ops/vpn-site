# Случайная строка для подписи сессий: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замените-на-случайную-строку
# Адрес сайта (с портом, если он не 443)
BASE_URL=https://vpn.example.com:8443
# Название, которое видят посетители
SITE_NAME=Tunnel
# Почта админов (через запятую): им открыта страница /admin
ADMIN_EMAILS=you@example.com
# Сколько ключей на одного пользователя
MAX_KEYS=3
# Тарифы: код:дней:цена в рублях:название, через запятую
PLANS=1m:30:199:1 месяц,3m:90:499:3 месяца,12m:365:1690:12 месяцев
# test — оплата-заглушка (деньги не списываются); yookassa — настоящая оплата
PAYMENT_PROVIDER=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
